# ─── Supabase Configuration ───
# These are used when you connect your Supabase project.
# The app works without these (uses mock data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── n8n Automation (Optional) ───
# Used for webhook triggers (booking confirmations, reminders, etc.)
# The app works normally if this is not set.
VITE_N8N_WEBHOOK_URL=
